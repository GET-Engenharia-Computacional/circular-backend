# Runtime
LOG_LEVEL=info
APP_PORT=8080
APP_ENVIRONMENT=development

# The API accepts requests from any browser origin.

# PostgreSQL used by docker-compose.
# For an externally managed database, replace DATABASE_HOST and credentials.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=circular_database
DATABASE_USERNAME=circular_app
DATABASE_PASSWORD=change-this-to-a-long-random-password
